# lab.suprabhat-dev.com on Hostinger (Apache / LiteSpeed)

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddDefaultCharset utf-8
AddCharset utf-8 .html .css .js .txt .xml .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (also behind Hostinger's proxy).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Clean URLs: /about/index.html -> /about/
  RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # Clean URLs: /about -> /about/ when the folder exists
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
  # The page CSP is a <meta> tag with hashes; frame-ancestors only works as a header.
  Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
  # Everything off. clipboard-write stays on for this origin so "Copy link" works.
  Header always set Permissions-Policy "accelerometer=(), ambient-light-sensor=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), clipboard-read=(), clipboard-write=(self), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), storage-access=(), usb=(), web-share=(), window-management=(), xr-spatial-tracking=()"

  # HTML and metadata: always revalidate.
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Fingerprinted build assets (only /_astro/ has JS and CSS) and self-hosted fonts.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# Analytics hook (off in v1). If a cookieless counter such as GoatCounter or a
# self-hosted Umami is added later, allow its origin in the CSP (astro.config.mjs)
# and say so on /about/ first.
