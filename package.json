{
  "name": "lab-suprabhat",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Free, open frontend tools and explainers. v1: CSS Specificity Wars.",
  "author": "Suprabhat Kumar <suprabhatkumar02@gmail.com> (https://suprabhat-dev.com)",
  "license": "MIT",
  "homepage": "https://lab.suprabhat-dev.com",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "fonts": "node scripts/copy-fonts.mjs && node scripts/font-fallbacks.mjs",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "predev": "npm run fonts",
    "dev": "astro dev",
    "prebuild": "npm run fonts && npm run contrast",
    "build": "astro build",
    "postbuild": "node scripts/report-sizes.mjs",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "contrast": "node scripts/contrast.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@bramus/specificity": "^2.4.3",
    "@fontsource-variable/figtree": "^5.3.0",
    "@ibm/plex-mono": "2.5.0",
    "@lucide/astro": "1.82.0",
    "astro": "^7.4.13",
    "astro-og-canvas": "^0.13.3",
    "css-tree": "^3.2.1",
    "inter-ui": "4.1.1",
    "parse5": "^8.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^4.4.0",
    "@capsizecss/unpack": "^4.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "dom-accessibility-api": "^0.7.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "fontkitten": "1.0.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "subset-font": "2.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
