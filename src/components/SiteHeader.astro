---
import ThemeToggle from './ThemeToggle.astro';
import { getTools } from '../lib/seo/tools';

interface Props {
  path: string;
}
const { path } = Astro.props;
const links = [
  ...(await getTools()).map((tool) => [`/${tool.data.slug}/`, tool.data.navLabel]),
  ['/about/', 'About'],
];
---

<header class="site-header">
  <div class="wrap site-header-inner">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      lab
      <span class="brand-slash" aria-hidden="true">
        /
      </span>
      <span class="visually-hidden"> home</span>
    </a>
    <details class="site-menu">
      <summary class="menu-summary">Menu</summary>
      <nav class="site-nav" aria-label="Main">
        {links.map(([href, label]) => (
          <a class="nav-link" href={href} aria-current={path === href ? 'page' : undefined}>
            {label}
          </a>
        ))}
      </nav>
    </details>
    <ThemeToggle />
  </div>
</header>
