---
interface Props {
  stacked?: boolean;
  inputLabelledby?: string;
}
const { stacked = false, inputLabelledby } = Astro.props;
if (Astro.slots.has('input') && !inputLabelledby) throw new Error('A workbench input needs a group label.');
---

<div class:list={['wrap', 'workbench', { 'workbench-stacked': stacked }]}>
  {Astro.slots.has('input') && (
    <div class="workbench-input flow" role="group" aria-labelledby={inputLabelledby}>
      <slot name="input" />
    </div>
  )}
  <div class="workbench-output flow">
    <slot name="output" />
  </div>
</div>
