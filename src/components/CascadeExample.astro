---
import { calculate } from '../lib/cascade/specificity';
import { encodeState } from '../lib/cascade/share';
import type { CascadeRow } from '../lib/cascade/share';
import { buildCascade } from '../lib/app/model';
import { DEFAULT_INPUTS } from '../lib/app/defaults';
import { rich, renderToString } from '../lib/view/h';
import LiveExample from './LiveExample.astro';

interface Props {
  caption: string;
  css: string;
  html: string;
  layerOrder?: string[];
  property?: string;
  rows: CascadeRow[];
}
const { caption, css, html, layerOrder = [], property = 'color', rows } = Astro.props;
const model = buildCascade({ property, layerOrder, rows }, calculate);
if (!model.result) throw new Error(`Cascade example failed: ${caption}: ${model.problem ?? ''}`);
const summaryHtml = rich(model.result.summary).map(renderToString).join('');
const encoded = encodeState({
  v: 1,
  mode: 'cascade',
  inputs: { ...DEFAULT_INPUTS, cascade: { property, layerOrder, rows } },
});
const tryHref = encoded.ok ? `/specificity/?s=${encoded.value}` : null;
---

<LiveExample
  caption={caption}
  css={css}
  html={html}
  summaryHtml={summaryHtml}
  tryHref={tryHref}
  tryLabel="Try this in the cascade resolver"
/>
