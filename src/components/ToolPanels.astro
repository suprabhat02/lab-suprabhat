---
import Anatomy from './Anatomy.astro';
import NestingPanel from './NestingPanel.astro';
import CascadeLadder from './CascadeLadder.astro';
import type { CascadeModel, DuelModel, NestingModel } from '../lib/app/model';

interface Props {
  duel: DuelModel;
  nestingCss: string;
  nesting: NestingModel;
  cascade: CascadeModel;
}
const { duel, nestingCss, nesting, cascade } = Astro.props;
---

<section class="section section-deferred" aria-label="Inspect selectors and the cascade">
  <div class="wrap tabs" data-tabs>
    <div class="tablist" role="tablist" aria-label="Inspect" data-tablist hidden>
      <button
        class="tab"
        type="button"
        role="tab"
        id="tab-anatomy"
        aria-controls="panel-anatomy"
        data-tab="anatomy"
      >
        Anatomy
      </button>
      <button
        class="tab"
        type="button"
        role="tab"
        id="tab-nesting"
        aria-controls="panel-nesting"
        data-tab="nesting"
      >
        Nesting
      </button>
      <button
        class="tab"
        type="button"
        role="tab"
        id="tab-cascade"
        aria-controls="panel-cascade"
        data-tab="cascade"
      >
        Cascade
      </button>
    </div>
    <Anatomy duel={duel} />
    <NestingPanel css={nestingCss} model={nesting} />
    <CascadeLadder model={cascade} />
  </div>
</section>
