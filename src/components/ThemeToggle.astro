---
import Icon from './Icon.astro';
---

<button
  class="button button-secondary button-sm theme-toggle"
  type="button"
  data-theme-toggle
  data-state="dark"
>
  <Icon name="moon" size={16} class="theme-icon theme-icon-dark" />
  <Icon name="sun" size={16} class="theme-icon theme-icon-light" />
  <span class="theme-toggle-text" data-theme-label>
    Dark theme
  </span>
  <span class="visually-hidden" data-theme-action>
    (switch to light)
  </span>
</button>
