---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import ToolPreview from './previews/ToolPreview.astro';
import { CATEGORY_ICONS } from '../lib/icons';
import { previewFor } from '../lib/previews';

interface Props {
  tool: CollectionEntry<'tools'>;
  /** The tools index groups by category, so its chip is the icon alone and the card shows status.
   *  Only home cards carry a preview. */
  variant?: 'home' | 'index';
}
const { tool, variant = 'home' } = Astro.props;
// Fails the build for a tool without a preview, even on pages that don't show one.
const preview = previewFor(tool.data.slug);
const dateFormat = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const status = tool.data.status === 'live' ? 'Live' : 'In progress';
---

<li class="tool-item">
  <div class="tool-head">
    <p class="tool-category" aria-hidden={variant === 'index' ? 'true' : undefined}>
      <Icon name={CATEGORY_ICONS[tool.data.category]} size={16} />
      {variant === 'home' && tool.data.category}
    </p>
    <Icon name="arrow-up-right" size={20} class="tool-arrow" />
  </div>
  <h3 class="tool-title">
    <a href={`/${tool.data.slug}/`}>{tool.data.title}</a>
  </h3>
  {(variant === 'index' || tool.data.status === 'in-progress') && <p class="tool-status">{status}</p>}
  <p class="prose">{tool.data.summary}</p>
  {variant === 'home' && <ToolPreview slug={preview} />}
  <p class="muted">
    <small>
      Updated{' '}
      <time datetime={tool.data.updatedAt.toISOString().slice(0, 10)}>
        {dateFormat.format(tool.data.updatedAt)}
      </time>
    </small>
  </p>
</li>
