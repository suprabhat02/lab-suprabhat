---
import { REPORT_URL } from '../lib/seo/links';

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['site-footer', { 'site-footer-home': home }]}>
  <div class="wrap stack">
    <p class="footer-slogan">Web for all, all for web.</p>
    <div class="site-footer-meta">
      <p>Free, no sign-up, no tracking.</p>
      <p>
        <a href="/tools/">All tools</a>
      </p>
      <p>
        <a href="/methodology/">How the tools are checked</a>
      </p>
      <p>
        <a href={REPORT_URL}>Report a wrong result</a>
      </p>
      <p>
        <a href="/about/">About this lab</a>
      </p>
      <p>
        <a href="https://suprabhat-dev.com">suprabhat-dev.com</a>
      </p>
      <p>&copy; {year} Suprabhat Kumar. Code under the MIT license.</p>
    </div>
  </div>
</footer>
