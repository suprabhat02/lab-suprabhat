---
import '../styles/tokens.css';
import '../styles/fonts.generated.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/utilities.css';
import themeScript from '../scripts/theme-inline.js?raw';
import SkipLink from '../components/SkipLink.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { graph } from '../lib/seo/entities';

export interface Crumb {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  /** Clean path of this page, e.g. `/specificity/`. Also the canonical URL. */
  path: string;
  /** OG image slug under /og/. */
  og: string;
  ogAlt: string;
  breadcrumbs?: Crumb[];
  /** This page's own schema.org nodes; the Person and the WebSite are added for every page. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, path, og, ogAlt, breadcrumbs = [], jsonLd = [], noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://lab.suprabhat-dev.com');
const canonical = new URL(path, site).href;
const ogImage = new URL(`/og/${og}.png`, site).href;

const nodes: Record<string, unknown>[] = [...jsonLd];
if (breadcrumbs.length > 0) {
  nodes.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.path, site).href,
    })),
  });
}
// Escape `<` so the JSON can never close the script element.
const ldJson = JSON.stringify(graph(nodes)).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#070c10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f9fafb" media="(prefers-color-scheme: light)" />
    <meta name="author" content="Suprabhat Kumar" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {/* Bing Webmaster Tools ownership check; Bing needs it on the home page and keeps checking it. */}
    {path === '/' && <meta name="msvalidate.01" content="4E5ECF05B712B40C5A4F9B6442206F3C" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Suprabhat's Lab" />
    <meta property="og:locale" content="en" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@SuprabhatKarn97" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href="/fonts/geist-mono-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline set:html={themeScript} />
    <script type="application/ld+json" set:html={ldJson} />
    {/*
        Analytics hook, off in v1. To add a cookieless counter later (GoatCounter or self-hosted Umami):
        1. add its script here, for example
           <script async src="https://stats.example.com/script.js" data-website-id="..."></script>
        2. allow its origin in security.csp (script-src and connect-src) in astro.config.mjs
        3. update the privacy section on /about/ before shipping.
      */}
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <SiteHeader path={path} />
    <main class="site-main" id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
