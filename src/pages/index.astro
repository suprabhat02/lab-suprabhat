---
import { getTools } from '../lib/seo/tools';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';

const tools = await getTools();
---

<BaseLayout
  title="Suprabhat's Lab: free frontend tools and explainers"
  description="Free, open frontend tools and explainers that make CSS and UI easier. No sign-up, no paywall, no tracking. Built for every device and assistive technology."
  path="/"
  og="home"
  ogAlt="Suprabhat's Lab: free frontend tools and explainers"
  breadcrumbs={[{ name: 'Lab', path: '/' }]}
>
  <section class="hub-hero hub-hero-home" aria-labelledby="hub-title">
    <div class="wrap flow">
      <h1 id="hub-title">Frontend tools that explain themselves</h1>
      <p class="tool-lead">
        Free tools and explainers for CSS and UI. No sign-up, no paywall, no tracking. They work on any device
        and with any assistive technology.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="tools-title">
    <div class="wrap flow">
      <h2 id="tools-title">Tools</h2>
      <ul class="tool-list" role="list">
        {tools.map((tool) => (
          <ToolCard tool={tool} />
        ))}
      </ul>
      <p class="prose">
        <a href="/tools/">Browse all tools by topic</a>. More tools are on the way. Each one gets the same
        treatment: a tool that answers the question, and an explainer that teaches the idea behind it. Read
        <a href="/about/">why this lab exists</a>, or see more work on
        <a href="https://suprabhat-dev.com">suprabhat-dev.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>
