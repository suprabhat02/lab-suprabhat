---
import { getTools } from '../lib/seo/tools';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import HeroDuel from '../components/HeroDuel.astro';
import Icon from '../components/Icon.astro';

const tools = await getTools();
---

<BaseLayout
  title="Suprabhat's Lab: free frontend tools and explainers"
  description="Free, open frontend tools and explainers that make CSS and UI easier. No sign-up, no paywall, no tracking. Built for every device and assistive technology."
  path="/"
  og="home"
  ogAlt="Suprabhat's Lab: free frontend tools and explainers"
  breadcrumbs={[{ name: 'Lab', path: '/' }]}
>
  <section class="hub-hero hub-hero-home" aria-labelledby="hub-title">
    <div class="wrap hairlines hero-grid">
      <div class="hero-copy flow">
        <h1 id="hub-title">
          <span class="hero-line">Frontend tools</span>
          <span class="hero-line">that explain</span>
          <span class="hero-line">themselves</span>
        </h1>
        <p class="tool-lead">
          Free tools and explainers for CSS and UI. No sign-up, no paywall, no tracking. They work on any
          device and with any assistive technology.
        </p>
      </div>
      <HeroDuel selectors={['#nav .link', 'nav ul li a:hover']} />
    </div>
  </section>

  <section class="section" aria-labelledby="tools-title">
    <div class="wrap flow">
      <h2 id="tools-title" class="home-heading section-heading hairlines">
        Tools
      </h2>
      <ul class="tool-list" role="list">
        {tools.map((tool) => (
          <ToolCard tool={tool} />
        ))}
      </ul>
      <!-- prettier-ignore -->
      <p class="prose home-body">
        <a href="/tools/">Browse all tools by topic</a>. More tools are on the way. Each one gets the same
        treatment: a tool that answers the question, and an explainer that teaches the idea behind it. Read
        <a href="/about/">why this lab exists</a>, or see more work on
        <a href="https://suprabhat-dev.com">suprabhat-dev.com<Icon name="arrow-up-right" size={16} class="icon-external" /></a>.
      </p>
    </div>
  </section>
</BaseLayout>
