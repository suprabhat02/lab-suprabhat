---
import { getTools } from '../lib/seo/tools';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import HeroDuel from '../components/HeroDuel.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { HERO_SELECTORS } from '../lib/app/defaults';

const tools = await getTools();
---

<BaseLayout
  title="Suprabhat's Lab: free frontend tools and explainers"
  description="Free, open frontend tools and explainers that make CSS and UI easier. No sign-up, no paywall, no tracking. Built for every device and assistive technology."
  path="/"
  og="home"
  ogAlt="Suprabhat's Lab: free frontend tools and explainers"
  breadcrumbs={[{ name: 'Lab', path: '/' }]}
>
  <section class="hub-hero hub-hero-home" aria-labelledby="hub-title" data-tone="plain">
    <div class="wrap hairlines hero-grid">
      <div class="hero-copy flow">
        <h1 id="hub-title">
          <span class="hero-line">Frontend tools</span>
          <span class="hero-line">that explain</span>
          <span class="hero-line">themselves</span>
        </h1>
        <p class="tool-lead">
          Free tools and explainers for CSS and UI. No sign-up, no paywall, no tracking. They work on any
          device and with any assistive technology.
        </p>
      </div>
      <HeroDuel selectors={HERO_SELECTORS} />
    </div>
  </section>

  <section class="section section-deferred" aria-labelledby="tools-title" data-tone="tint">
    <div class="wrap flow">
      <SectionHeader id="tools-title" title="Tools" icon="layout-grid" size="display" />
      <ul class="tool-list tool-list-bento" role="list">
        {tools.map((tool) => (
          <ToolCard tool={tool} />
        ))}
      </ul>
      <div class="link-strip">
        <p class="link-strip-lead">
          More tools are on the way. Each one gets the same treatment: a tool that answers the question, and
          an explainer that teaches the idea behind it.
        </p>
        <ul class="link-strip-list" role="list">
          <li>
            <a class="button button-outline" href="/tools/">
              Browse all tools by topic
              <Icon name="chevron-right" size={16} />
            </a>
          </li>
          <li>
            <a class="button button-outline" href="/about/">
              Why this lab exists
              <Icon name="chevron-right" size={16} />
            </a>
          </li>
          <li>
            <a class="button button-outline" href="https://suprabhat-dev.com">
              More work on suprabhat-dev.com
              <Icon name="arrow-up-right" size={16} />
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
