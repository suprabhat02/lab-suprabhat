---
import { getEntry } from 'astro:content';
import ToolLayout from '../../layouts/ToolLayout.astro';
import ToolWorkbench from '../../components/ToolWorkbench.astro';
import ExplainerBand from '../../components/ExplainerBand.astro';
import { buildContender } from '../../lib/app/model';
import { anatomyView, playgroundScoreView } from '../../lib/app/views';
import { calculate } from '../../lib/cascade/specificity';
import { PLAYGROUND_SELECTOR } from '../../lib/app/defaults';
import { renderToString } from '../../lib/view/h';

const tool = await getEntry('tools', 'playground');
if (!tool) throw new Error('Missing tools/playground.md');

const selector = PLAYGROUND_SELECTOR;
const contender = buildContender(selector, calculate);
const anatomy = anatomyView([contender]).map(renderToString).join('');
---

<ToolLayout
  tool={tool}
  title="Selector Playground: CSS Selector Analyzer"
  heading={tool.data.title}
  lead="Type a CSS selector. See every part, its specificity, and what to watch out for."
>
  <ToolWorkbench inputLabel="Selector source">
    <Fragment slot="input">
      <div class="field">
        <label class="label" id="playground-input-label" for="playground-selector">
          CSS selector
        </label>
        <input
          class="input input-selector"
          id="playground-selector"
          type="text"
          value={selector}
          spellcheck="false"
          autocapitalize="off"
          autocomplete="off"
          autocorrect="off"
          aria-describedby="playground-help playground-status"
        />
        <p class="input-help" id="playground-help">
          Up to 1,000 characters. The breakdown updates locally as you type. No input is put in the URL.
        </p>
        <p class="status" id="playground-status" role="status" aria-atomic="true"></p>
      </div>
      <div
        class="flow"
        id="playground-score"
        set:html={playgroundScoreView(contender).map(renderToString).join('')}
      />
    </Fragment>
    <Fragment slot="output">
      <nav class="results-nav" aria-label="Results sections">
        <a href="#playground-specificity">Specificity</a>
        <a href="#anatomy-title">Anatomy and warnings</a>
      </nav>
      <h2 id="anatomy-title">Selector anatomy</h2>
      <div class="anatomy" id="playground-anatomy" set:html={anatomy} />
    </Fragment>
  </ToolWorkbench>
  <ExplainerBand
    slot="explainer"
    labelledby="playground-explainer"
    title="Read a selector"
    tool={tool}
    tone="tint"
  >
    <div class="prose flow">
      <p class="prose">
        Underlines show the column: solid for IDs, dashed for the class column, dotted for the type column,
        double for functional pseudo-classes. Read{' '}
        <a href="/specificity/#how-calculated">how specificity is calculated</a>.
      </p>
    </div>
  </ExplainerBand>
</ToolLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('#playground-selector');
  const output = document.querySelector<HTMLElement>('#playground-anatomy');
  const status = document.querySelector<HTMLElement>('#playground-status');
  const score = document.querySelector<HTMLElement>('#playground-score');
  if (!input || !output || !status || !score) throw new Error('Missing playground elements.');

  let loading = false;
  async function enhance() {
    if (loading || !input || !output || !status || !score) return;
    loading = true;
    try {
      const { start } = await import('../../scripts/playground');
      start(input, output, status, score);
      input.removeEventListener('focus', enhance);
      input.removeEventListener('input', enhance);
    } catch (error) {
      loading = false;
      status.textContent = 'The analyzer could not load. Type again to retry, or reload the page.';
      console.error('Could not start the selector playground.', error);
    }
  }
  input.addEventListener('focus', enhance);
  input.addEventListener('input', enhance);
</script>
